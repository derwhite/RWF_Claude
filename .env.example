# Kopiere diese Datei zu ".env" und trage deine Werte ein.

# API-Key von raider.io (Settings -> Apps)
RAIDERIO_API_KEY=

# Slug des Bosses, dessen Pulls angezeigt werden sollen.
# Anleitung zum Herausfinden: siehe README.md, Abschnitt "Boss-Slug herausfinden".
BOSS_SLUG=

# Optional - Standardwerte passen bereits zum aktuellen Raid:
RAID_SLUG=the-venomous-abyss
DIFFICULTY=mythic

# Sekunden, die eine API-Antwort serverseitig zwischengespeichert wird,
# um das Raider.io Rate-Limit zu schonen.
CACHE_TTL_SECONDS=10

# Auf "true" setzen, um /debug/<guild> zur Fehlersuche zu aktivieren.
DEBUG_ROUTES=false

# Nur fuer serve.py relevant:
HOST=0.0.0.0
PORT=8080
WAITRESS_THREADS=4
